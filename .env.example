# ---------------------------------------------------------------------------
# BhoomiLens - sample environment configuration
# Copy to .env and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# Data source for the frontend: "mock" (in-browser synthetic engine) or "api"
VITE_DATA_SOURCE=mock

# Base URL of the BhoomiLens backend when VITE_DATA_SOURCE=api
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Deterministic seed for the synthetic data generation engine
VITE_DATA_SEED=20260909

# Synthetic dataset scale: "demo" | "standard" | "national"
# demo      ~   400 projects /   4k parcels  (fast, laptops)
# standard  ~  1500 projects /  12k parcels  (recommended)
# national  ~  1500 projects / 100k parcels  (heavy, 8GB+ RAM)
VITE_DATA_SCALE=standard

# Public basemap tiles (OpenStreetMap by default)
VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# --------------------------- Backend (FastAPI) -----------------------------
BHOOMILENS_ENV=development
BHOOMILENS_SECRET_KEY=bhoomilens-development-secret-key-change-me
BHOOMILENS_ACCESS_TOKEN_TTL_MINUTES=480
BHOOMILENS_DATA_SEED=20260909
BHOOMILENS_CORS_ORIGINS=http://localhost:5173

# Optional infrastructure (docker-compose provides defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bhoomilens
POSTGRES_USER=bhoomilens
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=bhoomilens-documents
