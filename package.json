{
  "name": "bhoomilens",
  "private": true,
  "version": "1.0.0",
  "description": "BhoomiLens - National Land Governance Intelligence Platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
